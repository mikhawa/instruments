{# Gabarit commun des e-mails de commande : mise en page sobre, compatible avec les clients de messagerie #}
<!DOCTYPE html>
<html lang="{{ commande.locale }}">
<body style="margin:0;padding:24px;background:#f4f1ea;font-family:Georgia,'Times New Roman',serif;color:#2b2420;">
    <div style="max-width:560px;margin:0 auto;background:#fffdf8;border:1px solid #e3dccd;padding:28px;">
        <p style="margin:0 0 20px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#8a6f4e;">Instruments traditionnels</p>
        {% block contenu %}{% endblock %}
        <p style="margin:28px 0 0;font-size:13px;color:#6b625a;">
            <a href="{{ urlSuivi }}" style="color:#8a4b2a;">Suivre ma commande {{ commande.numero }}</a><br>
            <a href="{{ urlSite }}" style="color:#8a4b2a;">{{ urlSite }}</a>
        </p>
    </div>
</body>
</html>
