# Routage en préprod / prod (CyberPanel, OpenLiteSpeed).
# En dev, Docker utilise nginx (docker/nginx/default.conf) et ignore ce fichier.
#
#   fichier existant             → servi tel quel (build React, assets, bundles, uploads)
#   /api, /admin, /bundles, /_*  → Symfony (index.php)
#   toute autre URL              → index.html (SPA React, routage côté client)
#
# OpenLiteSpeed ne lit que les règles de réécriture de ce fichier : les en-têtes de cache
# (index.html non mis en cache, cache long sur app/ et assets/) se règlent dans la
# configuration du site (voir docs/devops/vps-preprod.md § 2.4).
# OpenLiteSpeed transmet lui-même l'en-tête Authorization à PHP.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers réels : servis directement
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Routes Symfony (y compris un asset de bundle absent)
    RewriteRule ^(api|admin|bundles|_)(/|$) index.php [L]

    # Fichier statique manquant (image, script...) : laissé tel quel, le serveur répond 404
    # au lieu de renvoyer index.html
    RewriteRule \.[a-z0-9]{2,5}$ - [NC,L]

    # Toute autre URL : application React
    RewriteRule ^ index.html [L]
</IfModule>
