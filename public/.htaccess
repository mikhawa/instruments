# Routage en préprod / prod (Plesk, Apache derrière nginx).
# En dev, Docker utilise nginx (docker/nginx/default.conf) et ignore ce fichier.
#
#   fichier existant             → servi tel quel (build React, assets, bundles, uploads)
#   /api, /admin, /bundles, /_*  → Symfony (index.php)
#   toute autre URL              → index.html (SPA React, routage côté client)

DirectoryIndex index.html

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Transmet l'en-tête Authorization à PHP (utile pour une future authentification par jeton)
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Accès direct à index.php interdit : évite les URL en double (/index.php/api/...)
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) /$1 [R=301,L]

    # Fichiers réels : servis directement
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Routes Symfony (y compris un asset de bundle absent)
    RewriteRule ^(api|admin|bundles|_)(/|$) index.php [L]

    # Fichier statique manquant (image, script...) : 404 au lieu de renvoyer index.html
    RewriteRule \.[a-z0-9]{2,5}$ - [NC,R=404,L]

    # Toute autre URL : application React
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # index.html jamais mis en cache : il référence les fichiers versionnés du dernier build
    <Files "index.html">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

<IfModule mod_expires.c>
    # Fichiers versionnés par Vite (app/) et l'AssetMapper (assets/) : cache long
    <If "%{REQUEST_URI} =~ m#^/(app|assets)/#">
        ExpiresActive On
        ExpiresDefault "access plus 1 year"
    </If>
</IfModule>
